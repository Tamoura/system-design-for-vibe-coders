  "components": {
    "schemas": {
      "MonitorCreate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Checkout API"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://api.example.com/health"
          },
          "interval_seconds": {
            "default": 300,
            "type": "integer",
            "description": "Seconds between checks: 30, 60, 300 or 900. Never below your plan’s minimum.",
            "enum": [
              30,
              60,
              300,
              900
            ],
            "example": 300
          }
        },
        "required": [
          "name",
          "url"
        ],
        "description": "A new monitor."
      },
      "MonitorUpdate": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "example": "Checkout API"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://api.example.com/health"
          },
          "interval_seconds": {
            "type": "integer",
            "description": "Seconds between checks: 30, 60, 300 or 900. Never below your plan’s minimum.",
            "enum": [
              30,
              60,
              300,
              900
            ],
            "example": 300
          },
          "paused": {
            "type": "boolean",
            "description": "Pause or resume checks."
          }
        },
        "description": "The fields to change; omitted fields stay as they are."
      },
      "Monitor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Prefixed id.",
            "example": "mon_3f2a9c7e5b1d4e8fa6c0b2d4e6f80a1c"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "interval_seconds": {
            "type": "integer"
          },
          "paused": {
            "type": "boolean"
          },
          "paused_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "manual",
                  "plan_limit"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "\"plan_limit\": frozen after a downgrade."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the monitor was created.",
            "example": "2026-03-01T12:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "interval_seconds",
          "paused",
          "paused_reason",
          "created_at"
        ],
        "description": "An uptime monitor."
      },
      "Incident": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "inc_9f0e1d2c3b4a59687766554433221100"
          },
          "monitor_id": {
            "type": "string",
            "example": "mon_3f2a9c7e5b1d4e8fa6c0b2d4e6f80a1c"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "cause": {
            "type": "string",
            "example": "HTTP 503"
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the outage began.",
            "example": "2026-03-01T12:00:00.000Z"
          },
          "acknowledged_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When someone acknowledged it (this stops the escalation), or null.",
                "example": "2026-03-01T12:00:00.000Z"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "description": "When it was resolved.",
                "example": "2026-03-01T12:00:00.000Z"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "monitor_id",
          "status",
          "cause",
          "opened_at",
          "acknowledged_at",
          "resolved_at"
        ],
        "description": "An outage of one monitor."
      },
      "MonitorList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Monitor"
            }
          },
          "has_more": {
            "type": "boolean",
            "description": "More items after these: ask again with starting_after = next_cursor."
          },
          "next_cursor": {
            "description": "The id of the last monitor in this page, or null.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "has_more",
          "next_cursor"
        ],
        "description": "A page of monitors, newest first."
      },
      "IncidentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Incident"
            }
          },
          "has_more": {
            "type": "boolean",
            "description": "More items after these: ask again with starting_after = next_cursor."
          },
          "next_cursor": {
            "description": "The id of the last incident in this page, or null.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "data",
          "has_more",
          "next_cursor"
        ],
        "description": "A page of incidents, newest first."
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "Identifies the kind of problem; documented at that URL.",
            "example": "https://beacon.app/problems/rate-limited"
          },
          "title": {
            "type": "string",
            "description": "A short, fixed summary of the kind of problem.",
            "example": "Too many requests"
          },
          "status": {
            "type": "integer",
            "example": 429
          },
          "detail": {
            "description": "What happened this time.",
            "type": "string"
          },
          "instance": {
            "description": "The request path.",
            "type": "string"
          },
          "errors": {
            "description": "Validation problems, one per field.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "field",
                "message"
              ]
            }
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "description": "RFC 9457 problem details."
      }
    },
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "An organization API key (bk_live_…). Scopes: `monitors:read` (Read monitors), `monitors:write` (Create, change and delete monitors), `incidents:read` (Read incidents)."
      }
    }
  }
}

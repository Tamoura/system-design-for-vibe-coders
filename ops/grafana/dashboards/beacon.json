{
  "uid": "beacon",
  "title": "Beacon",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "beacon",
    "lesson-7.2"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Check lag p50 / p95 / p99 per region (lesson 7.2: Beacon's own health signal)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, region) (rate(check_lag_seconds_bucket[5m])))",
          "legendFormat": "p50 {{region}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, region) (rate(check_lag_seconds_bucket[5m])))",
          "legendFormat": "p95 {{region}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, region) (rate(check_lag_seconds_bucket[5m])))",
          "legendFormat": "p99 {{region}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Checks executed per second, up vs down",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(checks_executed_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "SLO: share of checks later than 15 s (budget 0.1%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "beacon:check_lag_bad_ratio:rate5m",
          "legendFormat": "5m"
        },
        {
          "refId": "B",
          "expr": "beacon:check_lag_bad_ratio:rate1h",
          "legendFormat": "1h"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API rate by route (RED: rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API errors (RED: errors, 5xx share)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_server_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum by (route) (rate(http_server_requests_total[5m])), 1e-9)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API duration p95 (RED: duration)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_server_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Jobs by queue and outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, outcome) (rate(jobs_total[5m]))",
          "legendFormat": "{{queue}} {{outcome}}"
        }
      ]
    }
  ]
}

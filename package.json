{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon — uptime monitoring and status pages for teams. The reference SaaS for the SaaS Building Blocks course.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:large": "tsx scripts/seed-large.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "checks:run": "tsx scripts/run-checks.ts",
    "worker": "tsx scripts/worker.ts",
    "jobs": "tsx scripts/jobs.ts",
    "usage:report": "tsx scripts/report-usage.ts",
    "email:preview": "tsx scripts/email-preview.ts",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "org:claim": "tsx scripts/claim-org.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@node-rs/argon2": "^2.2.1",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pg-boss": "^12.34.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/s3rver": "^3.7.4",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "mailparser": "^3.9.28",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.19.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}

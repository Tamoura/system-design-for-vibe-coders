{
  "name": "system-design-for-vibe-coders",
  "version": "1.0.0",
  "private": true,
  "description": "A course library: production engineering for AI-assisted builders (bilingual EN/AR), and SaaS Building Blocks for junior developers.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dist": "node scripts/build.mjs --all",
    "check": "node scripts/build.mjs --check",
    "saas:build": "node scripts/build-saas.mjs",
    "saas:check": "node scripts/build-saas.mjs --check",
    "saas:repos": "node scripts/check-saas-repos.mjs",
    "aigp:build": "node scripts/build-aigp.mjs",
    "aigp:check": "node scripts/build-aigp.mjs --check",
    "aipm:build": "node scripts/build-aipm.mjs",
    "aipm:check": "node scripts/build-aipm.mjs --check",
    "assess:build": "node scripts/build-assessment.mjs",
    "assess:check": "node scripts/build-assessment.mjs --check",
    "secai:build": "node scripts/build-secai.mjs",
    "secai:check": "node scripts/build-secai.mjs --check",
    "career:build": "node scripts/build-career.mjs",
    "career:check": "node scripts/build-career.mjs --check",
    "data:build": "node scripts/build-data.mjs",
    "data:check": "node scripts/build-data.mjs --check",
    "cloud:build": "node scripts/build-cloud.mjs",
    "cloud:check": "node scripts/build-cloud.mjs --check",
    "testing:build": "node scripts/build-testing.mjs",
    "testing:check": "node scripts/build-testing.mjs --check",
    "aiapps:build": "node scripts/build-aiapps.mjs",
    "aiapps:check": "node scripts/build-aiapps.mjs --check",
    "ainative:build": "node scripts/build-ainative.mjs",
    "ainative:check": "node scripts/build-ainative.mjs --check",
    "videos:build": "node scripts/build-videos.mjs",
    "videos:check": "node scripts/build-videos.mjs --check",
    "videos:render": "node scripts/build-videos.mjs --render",
    "qa": "python3 scripts/qa/run_all.py",
    "qa:cues": "python3 scripts/qa/quiz_cues.py",
    "qa:arabic": "python3 scripts/qa/arabic_rules.py",
    "qa:claims": "python3 scripts/qa/claims_lint.py",
    "qa:ar": "python3 scripts/qa/check_ar_all.py",
    "test:assess": "node scripts/tests/assessment-group.test.mjs"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "marked": "^15.0.7",
    "mermaid": "^11.4.1",
    "puppeteer": "^24.2.0"
  }
}

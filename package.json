{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon — uptime monitoring and status pages for teams. The reference SaaS for the SaaS Building Blocks course.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:large": "tsx scripts/seed-large.ts",
    "db:reset": "tsx scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "checks:run": "tsx scripts/run-checks.ts",
    "worker": "tsx scripts/worker.ts",
    "jobs": "tsx scripts/jobs.ts",
    "usage:report": "tsx scripts/report-usage.ts",
    "email:preview": "tsx scripts/email-preview.ts",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "storage:setup": "tsx scripts/storage-setup.ts",
    "org:claim": "tsx scripts/claim-org.ts",
    "flags": "tsx scripts/flags.ts",
    "staff": "tsx scripts/staff.ts",
    "audit": "tsx scripts/audit.ts",
    "env:docs": "tsx scripts/env-docs.ts",
    "env:docs:check": "tsx scripts/env-docs.ts --check",
    "build:scripts": "node scripts/build-scripts.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo \"✓ git hooks installed (.githooks/pre-commit runs gitleaks)\"",
    "secrets": "tsx scripts/secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@node-rs/argon2": "^2.2.1",
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-email/components": "^1.0.12",
    "@sentry/browser": "^11.0.0",
    "@sentry/node": "^11.0.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.6",
    "nodemailer": "^10.0.10",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/s3rver": "^3.7.4",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "mailparser": "^3.9.28",
    "s3rver": "^3.7.1",
    "smtp-server": "^3.19.13",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}

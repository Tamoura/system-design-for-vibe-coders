# Copy to .env.local and adjust. Never commit real secrets (lesson 8.1).
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
APP_URL=http://localhost:3000
# Lesson 1.1: signs session cookies and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Lesson 1.1 (optional): "Sign in with GitHub". Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:3000/api/auth/callback/github. Leave empty to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Lesson 2.2: where uploaded files (status page logos, incident screenshots) go.
#   local (default): files in .storage/, served by the app through signed, expiring URLs.
#   s3: any S3-compatible store (AWS S3, Cloudflare R2, Garage, SeaweedFS). Fill in the
#       S3_* values and run `npm run storage:setup` once (bucket, private, CORS).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=beacon-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Lesson 3.1–3.3: billing. Leave everything empty and billing is off.
#   Development without Stripe: BILLING_PROVIDER=fake (an in-memory stand-in;
#   "Upgrade" opens a fake Checkout page inside Beacon). Never in production.
#   Stripe test mode: set the secret key, the webhook secret printed by
#   `stripe listen --forward-to localhost:3000/api/stripe/webhook`, and the
#   Price ids from your test-mode dashboard (see docs/SOLUTIONS.md, Module 3).
# BILLING_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Lesson 3.3 (optional): metered SMS prices (meter "sms_segments", first 100 / 500 units free, then $0.05).
STRIPE_PRICE_PRO_SMS=
STRIPE_PRICE_BUSINESS_SMS=
# Lesson 4.1: transactional email. Every email is queued (email_outbox + a job) and sent by
# the worker (`npm run worker`, lesson 5.1), which also retries after a provider outage.
#   smtp (default): SMTP_URL, Mailpit from docker compose in development (inbox: http://localhost:8025).
#   resend: set RESEND_API_KEY (used automatically when set), and verify your sending domain.
#   console: print emails in the terminal, for a laptop without Mailpit.
# EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
# The From addresses: transactional mail, and the separate stream for status-page subscribers.
EMAIL_FROM=Beacon <notifications@mail.beacon.app>
EMAIL_FROM_STATUS=Beacon Status <status@updates.beacon.app>
# Signing secret of the provider's bounce/complaint webhook → POST /api/email/webhook
EMAIL_WEBHOOK_SECRET=
# Lesson 4.2: notification channels. Without a provider, SMS deliveries are logged as "skipped".
#   SMS_PROVIDER=fake     development: SMS are printed in the terminal and still metered (lesson 3.3)
#   Twilio: set all three below instead.
# SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Slack: each org pastes its own incoming-webhook URL in Settings. SLACK_PROVIDER=fake prints
# the messages instead of posting them (development without internet).
# SLACK_PROVIDER=fake
# Lesson 5.3: Beacon refuses to fetch internal addresses (loopback, private, link-local/cloud
# metadata…) for monitors and webhooks. DEVELOPMENT ONLY: host[:port] pairs let through anyway,
# e.g. Beacon monitoring itself, or a local webhook receiver. Leave it empty in production.
OUTBOUND_ALLOWLIST=localhost:3000

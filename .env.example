# Copy to .env.local and adjust. Never commit real secrets (lesson 8.1).
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
APP_URL=http://localhost:3000
# Lesson 1.1: signs session cookies and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Lesson 1.1 (optional): "Sign in with GitHub". Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:3000/api/auth/callback/github. Leave empty to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Copy to .env.local and adjust. Never commit real secrets (lesson 8.1).
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
APP_URL=http://localhost:3000
# Lesson 1.1: signs session cookies and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Lesson 1.1 (optional): "Sign in with GitHub". Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:3000/api/auth/callback/github. Leave empty to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Lesson 2.2: where uploaded files (status page logos, incident screenshots) go.
#   local (default): files in .storage/, served by the app through signed, expiring URLs.
#   s3: any S3-compatible store (AWS S3, Cloudflare R2, Garage, SeaweedFS). Fill in the
#       S3_* values and run `npm run storage:setup` once (bucket, private, CORS).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=beacon-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Copy to .env.local and adjust. Never commit real secrets (lesson 8.1).
# Lesson 7.4: every variable is checked at startup (src/lib/env.ts); the full list, generated from
# that schema, is docs/configuration.md. `npm run worker`, `db:migrate` and the other scripts read
# .env.local too. For docker-compose.prod.yml, copy this file to .env instead.
DATABASE_URL=postgres://beacon:beacon@localhost:5432/beacon
# Lesson 7.4: development | preview | staging | production. Production refuses development-only settings.
# APP_ENV=development
APP_URL=http://localhost:3000
# Lesson 1.1: signs session cookies and tokens. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Lesson 1.1 (optional): "Sign in with GitHub". Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:3000/api/auth/callback/github. Leave empty to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Lesson 2.2: where uploaded files (status page logos, incident screenshots) go.
#   local (default): files in .storage/, served by the app through signed, expiring URLs.
#   s3: any S3-compatible store (AWS S3, Cloudflare R2, Garage, SeaweedFS). Fill in the
#       S3_* values and run `npm run storage:setup` once (bucket, private, CORS).
STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=.storage
# S3_BUCKET=beacon-files
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Lesson 3.1–3.3: billing. Leave everything empty and billing is off.
#   Development without Stripe: BILLING_PROVIDER=fake (an in-memory stand-in;
#   "Upgrade" opens a fake Checkout page inside Beacon). Never in production.
#   Stripe test mode: set the secret key, the webhook secret printed by
#   `stripe listen --forward-to localhost:3000/api/stripe/webhook`, and the
#   Price ids from your test-mode dashboard (see docs/SOLUTIONS.md, Module 3).
# BILLING_PROVIDER=fake
# Lesson 7.1: a free trial on new subscriptions (the thing Beacon support can extend, ≤ 14 days at a time).
# BILLING_TRIAL_DAYS=14
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Lesson 3.3 (optional): metered SMS prices (meter "sms_segments", first 100 / 500 units free, then $0.05).
STRIPE_PRICE_PRO_SMS=
STRIPE_PRICE_BUSINESS_SMS=
# Lesson 4.1: transactional email. Every email is queued (email_outbox + a job) and sent by
# the worker (`npm run worker`, lesson 5.1), which also retries after a provider outage.
#   smtp (default): SMTP_URL, Mailpit from docker compose in development (inbox: http://localhost:8025).
#   resend: set RESEND_API_KEY (used automatically when set), and verify your sending domain.
#   console: print emails in the terminal, for a laptop without Mailpit.
# EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
# The From addresses: transactional mail, and the separate stream for status-page subscribers.
EMAIL_FROM=Beacon <notifications@mail.beacon.app>
EMAIL_FROM_STATUS=Beacon Status <status@updates.beacon.app>
# Signing secret of the provider's bounce/complaint webhook → POST /api/email/webhook
EMAIL_WEBHOOK_SECRET=
# Lesson 4.2: notification channels. Without a provider, SMS deliveries are logged as "skipped".
#   SMS_PROVIDER=fake     development: SMS are printed in the terminal and still metered (lesson 3.3)
#   Twilio: set all three below instead.
# SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Slack: each org pastes its own incoming-webhook URL in Settings. SLACK_PROVIDER=fake prints
# the messages instead of posting them (development without internet).
# SLACK_PROVIDER=fake
# Lesson 5.3: Beacon refuses to fetch internal addresses (loopback, private, link-local/cloud
# metadata…) for monitors and webhooks. DEVELOPMENT ONLY: host[:port] pairs let through anyway,
# e.g. Beacon monitoring itself, or a local webhook receiver. Leave it empty in production.
OUTBOUND_ALLOWLIST=localhost:3000
# Lesson 6.2: product analytics. Events are always recorded server-side in Postgres
# (analytics_events). To also forward them to PostHog (the worker sends batches):
# ANALYTICS_DRIVER=posthog
POSTHOG_API_KEY=
# POSTHOG_HOST=https://eu.i.posthog.com
# Lesson 6.2 (optional): cookieless web analytics (Plausible) on the marketing site only.
# Read at BUILD time (NEXT_PUBLIC_…). Leave empty to load no script at all.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Lesson 7.1: Beacon staff are rows in the staff_users table, not an environment variable
# (Module 6's BEACON_STAFF_EMAILS is gone): `npm run staff -- add you@example.com superadmin "why"`.
# How often every process reloads the flag rules, in seconds (a flipped kill switch lands within this).
# FLAGS_REFRESH_SECONDS=15
# Lesson 7.2: observability. Logs are JSON lines on stdout (pipe through `npx pino-pretty` to read them).
# LOG_LEVEL=info
# Errors to Sentry or GlitchTip (server and worker). NEXT_PUBLIC_SENTRY_DSN is for the browser, read at BUILD time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# OpenTelemetry traces and metrics: to a collector (docker-compose.observability.yml listens on 4318),
# or OTEL_EXPORTER=console to print them.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER=console
# The checker's region, a label on check metrics.
# CHECK_REGION=local
# Lesson 7.4: docker-compose.prod.yml only. The Postgres password of its database container.
# POSTGRES_PASSWORD=change-me
# Lesson 8.1: keys that encrypt the secrets Beacon stores for customers (webhook signing secrets, Slack URLs).
# A keyring, newest first: `npm run secrets -- generate-key` prints one. Required in production; without it,
# development uses a public development key (and says so). Rotation: docs/security/secrets.md.
# ENCRYPTION_KEYS=k1:<base64 of 32 bytes>
# KMS_DRIVER=local
# The Contact of /.well-known/security.txt (a mailto: or https: URI).
# SECURITY_CONTACT=mailto:security@example.com
# Lesson 8.2: AI incident summaries (Business plan, off per org until an owner or admin turns them on).
# Without ANTHROPIC_API_KEY the gateway uses a built-in fake provider: no network, no cost.
# The key is read on the server only; never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_FALLBACK_MODEL=claude-sonnet-5
# AI_TIMEOUT_MS=30000
# The fallback drill: point only the primary somewhere that fails, and summaries come from the fallback model.
# AI_PRIMARY_BASE_URL=http://127.0.0.1:9

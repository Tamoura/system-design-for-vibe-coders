     # -- helpers -------------------------------------------------------------
+    def _check_rules(
+        self, customer: Customer, recipient: str, corridor: Corridor, send_amount: Money, now: Any
+    ) -> LimitResult:
+        """Steps 2 and 3 of ``send``: the limits, then screening. Returns the limit position before this transfer."""
+        limits = check_limits(customer.kyc_tier, self.store.list_transfers(customer.id), send_amount, now)
+        if not limits.allowed:
+            self._reject(customer, "limit_exceeded", corridor, send_amount, recipient)
+            raise LimitExceeded(limits)
+
+        screened = screen_names([customer.name, recipient], self.watchlist)
+        if screened.hit:
+            self._reject(customer, "needs_review", corridor, send_amount, recipient)
+            raise ScreeningHit(screened.matches)
+        return limits
+
+    def _price(
+        self, corridor: Corridor, send_amount: Money, method: str, express: bool, quote: Quote | None, now: Any
+    ) -> tuple[Money, FxQuote]:
+        """Steps 4 and 5 of ``send``: the fee and the rate, from the quote the customer saw or priced now."""
+        if quote is not None:
+            if (quote.corridor.code, quote.send_amount, quote.express, quote.delivery_method) != (
+                corridor.code,
+                send_amount,
+                express,
+                method,
+            ):
+                raise QuoteMismatch("the quote does not match this transfer")
+            if quote.fx.is_expired(now):
+                raise QuoteExpired(f"the quote expired at {quote.fx.expires_at.isoformat()}")
+            return quote.fee, quote.fx
+        return quote_fee(send_amount, corridor, express=express), fx_quote(send_amount, corridor, self.rates, now)
+

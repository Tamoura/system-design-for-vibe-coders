{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python scripts/depcheck.py)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Edit(/src/remit/money.py)",
      "Edit(/src/remit/fees.py)",
      "Edit(/src/remit/fx.py)",
      "Edit(/src/remit/limits.py)",
      "Edit(/src/remit/ledger.py)",
      "Edit(/src/remit/service.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
